{
  "name": "xd-components",
  "version": "0.1.0",
  "description": "Modular React component library",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xavierDelaFuente/xd-components.git"
  },
  "scripts": {
    "build": "pnpm --filter=\"./packages/*\" build",
    "test": "pnpm --filter=\"./packages/*\" test",
    "test:watch": "pnpm --filter=\"./packages/*\" test --watch",
    "test:coverage": "pnpm --filter=\"./packages/*\" test:coverage",
    "lint": "biome lint packages",
    "type-check": "tsc --noEmit",
    "format": "biome format --write packages",
    "check": "pnpm lint && pnpm format && pnpm type-check",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@asnewyla/button": "workspace:*",
    "@asnewyla/button-group": "workspace:*",
    "@asnewyla/icon-button": "workspace:*",
    "@asnewyla/image": "workspace:*",
    "@asnewyla/input": "workspace:*",
    "@asnewyla/layout": "workspace:*",
    "@asnewyla/tokens": "workspace:*",
    "@asnewyla/unstyled-button": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^3.0.1",
    "@chromatic-com/storybook": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "storybook": "^10.5.10",
    "typescript": "^5.5.0"
  }
}
