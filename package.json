{
  "name": "xd-components",
  "version": "0.1.0",
  "description": "Modular React component library",
  "private": true,
  "scripts": {
    "build": "pnpm --filter=\"./packages/*\" build",
    "test": "pnpm --filter=\"./packages/*\" test",
    "test:watch": "pnpm --filter=\"./packages/*\" test --watch",
    "test:coverage": "pnpm --filter=\"./packages/*\" test:coverage",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,css}\"",
    "check": "pnpm lint && pnpm format && pnpm type-check",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.3.0"
  }
}